[package]
name = "{{package_name}}"
version = "{{version}}"
edition = "2021"
description = "Generated MCP proxy for {{server_name}}"

[dependencies]
turbomcp-client = "{{turbomcp_version}}"
turbomcp-protocol = "{{turbomcp_version}}"
turbomcp-server = { version = "{{turbomcp_version}}", features = [{{#each transport_features}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}] }
turbomcp-transport = "{{turbomcp_version}}"

tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
{{#each additional_dependencies}}
{{this.name}} = {{#if this.version}}"{{this.version}}"{{else}}{{this.spec}}{{/if}}
{{/each}}

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = true
