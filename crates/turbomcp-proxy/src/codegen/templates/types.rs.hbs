{{/if}}
{{#if this.rename}}
    #[serde(rename = "{{this.rename}}")]
{{/if}}
{{#if this.optional}}
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub {{this.name}}: Option<{{this.rust_type}}>,
{{else}}
    pub {{this.name}}: {{this.rust_type}},
{{/if}}
{{/each}}
}

